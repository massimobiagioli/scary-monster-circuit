#!/usr/bin/env bash
# Stream the Pico's USB serial logs and stop cleanly on Ctrl-C.
#
# Uses a local .venv (created on first use) like the other project tools.
#
# Usage: tools/logs/logs
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$DIR/.venv"

if [ ! -x "$VENV/bin/python" ]; then
    echo "creating virtual environment in $VENV" >&2
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install --quiet --upgrade pip
    "$VENV/bin/pip" install --quiet -r "$DIR/requirements.txt"
fi

exec "$VENV/bin/python" "$DIR/logs.py" "$@"
