#!/usr/bin/env bash
# Convert a Markdown file (with Mermaid diagrams) to PDF using a local .venv.
#
# Usage: tools/md2pdf/md2pdf <input.md> <output.pdf>
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$DIR/.venv"

if [ ! -x "$VENV/bin/python" ]; then
    echo "creating virtual environment in $VENV" >&2
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install --quiet --upgrade pip
    "$VENV/bin/pip" install --quiet -r "$DIR/requirements.txt"
fi

exec "$VENV/bin/python" "$DIR/md2pdf.py" "$@"
